# Feishu custom app credentials
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_me

# DeepSeek API credential
DEEPSEEK_API_KEY=replace_me
# Optional; defaults to the pinned Pi source's fast DeepSeek model.
# DEEPSEEK_MODEL=deepseek-flash

# Optional Jev context selection. Uses pinned jev-1.13.0; no key uses recent history.
# JEV_API_KEY=replace_me
# AGENT_CONTEXT_SELECTION=off

# Optional public web search. Leave unset to disable the web_search tool.
# TAVILY_API_KEY=replace_me

# Optional local-only workspaces, prompt additions, and command tools.
# The default location is .private/agent.json when this variable is omitted.
# AGENT_LOCAL_CONFIG=.private/agent.json
