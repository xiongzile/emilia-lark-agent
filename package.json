{
  "name": "emilia-lark-agent",
  "version": "1.0.0",
  "description": "A self-hosted Lark bot powered by DeepSeek and extensible local tools",
  "main": "dist/index.js",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "tsc",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "eval:agent": "pnpm build && node --env-file-if-exists=.env tests/eval-agent.mjs",
    "build:pi": "node scripts/build-pi.mjs",
    "audit:public": "node scripts/check-public.mjs",
    "debug:agent": "node --env-file-if-exists=.env --inspect-brk --enable-source-maps src/index.ts",
    "start": "node --env-file-if-exists=.env --enable-source-maps src/index.ts",
    "service:install": "zsh scripts/install-launch-agent.sh",
    "service:status": "zsh scripts/status-launch-agent.sh",
    "service:uninstall": "zsh scripts/uninstall-launch-agent.sh"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "link:vendor/pi/packages/agent",
    "@earendil-works/pi-ai": "link:vendor/pi/packages/ai",
    "@larksuiteoapi/node-sdk": "^1.74.0"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  },
  "private": true,
  "license": "MIT"
}
